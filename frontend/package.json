{
  "name": "mateerp-frontend",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
