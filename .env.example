# MateERP local development environment.
# Copy to `.env` (never commit `.env`) and set real values.
# Used by Docker Compose and by the backend when run natively.

# --- PostgreSQL (container: mateerp-db) -----------------------------------
POSTGRES_DB=mateerp
POSTGRES_USER=mateerp
POSTGRES_PASSWORD=change-me-local-only

# Host ports. Bound to 127.0.0.1 only; chosen to avoid other local projects.
MATEERP_DB_PORT=55432
MATEERP_BACKEND_PORT=8100

# --- Django backend --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_LOG_LEVEL=INFO
# Company operating time zone (timestamps are stored in UTC).
DJANGO_TIME_ZONE=Asia/Dhaka

# Only used when running the backend natively (outside Docker).
# Compose builds its own container-internal URL.
DATABASE_URL=postgres://mateerp:change-me-local-only@127.0.0.1:55432/mateerp
