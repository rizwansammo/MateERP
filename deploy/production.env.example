# Template only. Place real values in /opt/MateERP/.env.production (0600).
# Use URL-safe characters in MATEERP_DB_PASSWORD, because it is included in DATABASE_URL.
MATEERP_DB_NAME=mateerp
MATEERP_DB_USER=mateerp
MATEERP_DB_PASSWORD=REPLACE_USING_SECRETS_TOKEN_URLSAFE
DJANGO_SECRET_KEY=REPLACE_USING_SECRETS_TOKEN_URLSAFE_AT_LEAST_50_CHARS
# MATEERP_IMAGE_TAG is set by the deploy script and never stored here.
