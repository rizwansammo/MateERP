# Root-owned /etc/mateerp/backup.env (0600), provision only at go-live.
# REPLACE with strong Restic password file stored outside the backup repository.
RESTIC_REPOSITORY=/opt/MateERP/backups/repository
RESTIC_PASSWORD_FILE=/etc/mateerp/restic-password
# Independent external repository, e.g. S3-compatible object storage.
# Credentials are provisioned through a root-only environment file or IAM role.
# Never store an offsite password in the Git repository.
MATEERP_OFFSITE_REPOSITORY=
MATEERP_OFFSITE_PASSWORD_FILE=/etc/mateerp/restic-offsite-password
